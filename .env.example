# GEMINI_API_KEY: Required only if optional AI features are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Required in production (minimum 32 random characters).
# Used for server-side token signing; startup fails in production if missing or shorter than 32 chars.
SESSION_SECRET=""

# ENABLE_DEMO_MODE: Defaults to "false" in production.
# Set to "true" ONLY in local development when testing sample synthetic accounts.
ENABLE_DEMO_MODE="false"

# FIREBASE_SERVICE_ACCOUNT_JSON: Required for persistent Cloud Firestore server operations.
# Obtain from Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Store strictly as a server-side environment secret; never expose in frontend code.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# INITIAL_ADMIN_EMAIL: Optional comma-separated verified admin email(s) allowed to auto-provision
# the first system_admin account only when zero active system_admin users exist in Firestore.
INITIAL_ADMIN_EMAIL=""

# ADMIN_BOOTSTRAP_TOKEN: Optional secret token (min 16 chars) required by POST /api/admin/bootstrap
# to promote the very first system_admin account when zero active system_admin users exist.
ADMIN_BOOTSTRAP_TOKEN=""

# REDIS_URL: Optional Redis connection URL (e.g. rediss://...) for multi-instance QR Pub/Sub & distributed locks.
REDIS_URL=""

# VITE_WS_URL: Optional dedicated WebSocket server URL (e.g. wss://ws.lasuattend.edu.ng)
# when hosting the frontend on Vercel Serverless while running persistent WebSockets on a Node host.
VITE_WS_URL=""
