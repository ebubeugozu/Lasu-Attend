# GEMINI_API_KEY: Required if optional AI features are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Required in production for signing server tokens (at least 32 random chars).
SESSION_SECRET=""

# ENABLE_DEMO_MODE: Set to "true" ONLY for development/demo testing. Set to "false" in production.
ENABLE_DEMO_MODE="true"

# FIREBASE_SERVICE_ACCOUNT_JSON: Required for production Cloud Firestore server operations.
# Obtain from Firebase Console > Project Settings > Service Accounts > Generate new private key.
# Store strictly as a server-side environment secret; never expose in frontend code.
FIREBASE_SERVICE_ACCOUNT_JSON=""
